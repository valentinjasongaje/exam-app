// Prisma schema for the exam review app.
// Production target: PostgreSQL (Neon / Supabase).
// See README.md for how this was verified locally against SQLite
// before pointing DATABASE_URL at a real Postgres instance.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Content model (seeded from scraped HTML) ----------

model Subject {
  id        String   @id @default(cuid())
  name      String // e.g. "ECT", "HB Elec"
  slug      String   @unique
  createdAt DateTime @default(now())

  exams    Exam[]
  attempts Attempt[]
}

model Exam {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  title       String // e.g. "ECT Pre Board Exam 1"
  slug        String   @unique
  sourceFile  String // original scraped filename, for traceability
  sourceTag   String? // the old "data-id" grouping value from the scrape, if present
  isBoardExam Boolean  @default(false) // true = full board/preboard exam (e.g. 100 items); enables the timed Board exam mode. Most imported exams are shorter practice sets (25/50 items) and stay false.
  createdAt   DateTime @default(now())

  questions Question[]
  attempts  Attempt[]
}

model Question {
  id           String  @id @default(cuid())
  examId       String
  exam         Exam    @relation(fields: [examId], references: [id])
  order        Int // position within the exam
  text         String
  imageUrl     String? // re-hosted question image, if the scrape had one
  explanation  String? // solution text, if the scrape had one
  explanationImageUrl String? // re-hosted solution image, if any
  sourceItemId String // original numeric "data-item" id from the scrape, for traceability

  choices        Choice[]
  attemptAnswers AttemptAnswer[]
  aiExplanations QuestionExplanation[]

  @@unique([examId, sourceItemId])
  @@index([examId, order])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  label      String // "A" | "B" | "C" | "D"
  text       String
  isCorrect  Boolean  @default(false)

  attemptAnswers AttemptAnswer[]

  @@unique([questionId, label])
}

// ---------- Users & activity ----------

enum Role {
  USER
  ADMIN
}

enum AttemptLayout {
  ALL_AT_ONCE
  ONE_AT_A_TIME
}

enum AttemptMode {
  PRACTICE
  BOARD_EXAM
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  role            Role          @default(USER)
  preferredLayout AttemptLayout @default(ONE_AT_A_TIME)
  shuffleEnabled  Boolean       @default(true)
  instantFeedback Boolean       @default(false) // practice + one-at-a-time only: reveal answer/explanation right after answering
  calendarToken   String?       @unique // secret for the read-only ICS feed at /api/calendar/<token>; null = feed off
  createdAt       DateTime      @default(now())

  attempts      Attempt[]
  studySessions StudySession[]
  studyTopics   StudyTopic[]
  studyVideos   StudyVideo[]
  overrides     ScheduleOverride[]
  events        CalendarEvent[]
  reminders     ReviewReminder[]
  aiExplanations QuestionExplanation[]
  notes          StudyNote[]
  formulaCards   FormulaCard[]
  drive          DriveConnection?
}

model Attempt {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  examId         String? // null for composed attempts (mock board exam / weak-question drill)
  exam           Exam?         @relation(fields: [examId], references: [id])
  subjectId      String? // denormalized from exam, or set directly for mock board exams; null for cross-subject drills
  subject        Subject?      @relation(fields: [subjectId], references: [id])
  questionIds    Json? // ordered question-id array for composed attempts; null = use exam.questions
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  score          Int? // number correct, filled in on submit
  totalQuestions Int
  layout         AttemptLayout @default(ALL_AT_ONCE)
  shuffleSeed    Int? // null = no shuffle; see lib/shuffle.ts
  mode           AttemptMode   @default(PRACTICE)
  timeLimitMinutes Int? // set for BOARD_EXAM attempts (e.g. 240); null = untimed
  showFeedback   Boolean       @default(false) // frozen from User.instantFeedback at creation

  answers AttemptAnswer[]

  @@index([userId, examId])
  @@index([userId, subjectId])
}

model AttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  choiceId   String? // null if the user skipped the question
  choice     Choice?  @relation(fields: [choiceId], references: [id])
  isCorrect  Boolean  @default(false)
  answeredAt DateTime @default(now())

  @@unique([attemptId, questionId])
}

// ---------- Study tracker (personal review plan, not exam content) ----------
// `subject` holds a CANONICAL_SUBJECTS slug from lib/subjects.ts ("math",
// "geas", "elex", "est"), kept as a plain string like the import flow does,
// so the tracker doesn't depend on Subject rows existing.

enum StudyActivity {
  VIDEO
  PROBLEMS
  QUIZ
  REVIEW
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  NEEDS_REVIEW
}

model StudySession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date // local (Asia/Manila) calendar day
  subject   String
  minutes   Int
  activity  StudyActivity @default(VIDEO)
  score     Int? // quiz only: number correct
  total     Int? // quiz only: number of items
  note      String?
  createdAt DateTime      @default(now())

  @@index([userId, date])
}

model StudyTopic {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  name        String
  order       Int         @default(0)
  status      TopicStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  reminders ReviewReminder[]

  @@index([userId, subject])
}

model StudyVideo {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  title           String
  url             String?
  section         String? // watch-plan section from lib/video-library.ts ("core", "math-basics", "refresher", "optional-basics"); null = added by hand
  localPath       String? // where the file lives on the user's drive, e.g. G:\\Excel Review Center\\...\\MATH01.mp4
  driveFileId     String? // Google Drive copy uploaded through the app (watchable anywhere); null = not on Drive
  driveUploadedAt DateTime?
  durationMinutes Int
  watchedMinutes  Int       @default(0)
  order           Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, subject])
}

// ---------- Calendar ----------
// The weekly plan itself is generated in code (lib/schedule.ts); only the
// user's changes to it are stored.

enum OverrideAction {
  SKIP
  MOVE
}

/// A change to one generated plan block on one day (skip it, or move it).
model ScheduleOverride {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date // the block's original day
  blockKey  String // template block key from lib/schedule.ts, e.g. "tue-ptk"
  action    OverrideAction
  newDate   DateTime?      @db.Date // MOVE only
  newStart  String? // MOVE only, "HH:MM"
  newEnd    String? // MOVE only, "HH:MM"
  createdAt DateTime       @default(now())

  @@unique([userId, date, blockKey])
  @@index([userId, newDate])
}

enum CalendarEventKind {
  EVENT
  DEADLINE
  BUSY
}

model CalendarEvent {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime          @db.Date
  start     String? // "HH:MM"; null = all-day
  end       String?
  title     String
  kind      CalendarEventKind @default(EVENT)
  note      String?
  createdAt DateTime          @default(now())

  @@index([userId, date])
}

/// Spaced re-review of a topic, created when the topic is marked Done or Needs review.
model ReviewReminder {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     StudyTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  dueDate   DateTime   @db.Date
  step      Int // 1-based position in the interval sequence
  doneAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, dueDate])
  @@index([topicId])
}

// ---------- AI explanations ----------

/// Claude-written explanation of a question, cached so re-opening it is free.
/// Keyed by the choice the user picked ("skipped" when they left it blank),
/// since the explanation addresses that specific mistake.
model QuestionExplanation {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceKey  String // Choice.id the user picked, or "skipped"
  userId     String // who generated it (for the daily limit)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  model      String
  createdAt  DateTime @default(now())

  @@unique([questionId, choiceKey])
  @@index([userId, createdAt])
}

// ---------- Notes & formula recall ----------

/// A topic note: free-text notes plus the formulas to memorize for that topic.
model StudyNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String // tracker subject slug ("math", "geas", "elex", "est")
  topic     String
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards FormulaCard[]

  @@index([userId, subject])
}

/// One formula to recall. Spaced repetition (Leitner boxes): a correct recall
/// moves it up a box and pushes dueDate out; a miss sends it back to box 0.
model FormulaCard {
  id             String    @id @default(cuid())
  noteId         String
  note           StudyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String // what you're asked, e.g. "Capacitive reactance"
  formula        String // the answer, e.g. "Xc = 1 / (2πfC)"
  hint           String? // optional: units, when to use it
  order          Int       @default(0)
  box            Int       @default(0)
  dueDate        DateTime? @db.Date // null = due now
  lastReviewedAt DateTime?
  correct        Int       @default(0)
  wrong          Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([userId, dueDate])
  @@index([noteId])
}

// ---------- Google Drive (video uploads) ----------

/// The user's Google Drive link, separate from sign-in. Scope is drive.file:
/// the app only sees files it uploaded itself.
model DriveConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail     String?
  refreshTokenEnc String // AES-256-GCM, key derived from AUTH_SECRET (lib/google-drive.ts)
  folderId        String? // "ECE Review Videos" folder the app created
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
